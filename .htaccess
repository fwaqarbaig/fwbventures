# ==============================================================================
# FWB Ventures - Root Directory Configuration (Hostinger / cPanel / LiteSpeed)
# Seamlessly routes all traffic into /public/ without showing /public in the URL
# ==============================================================================

DirectoryIndex public/index.php index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Block direct access to sensitive system files and folders
    RewriteRule ^(\.env|\.git|\.github|composer\.|package\.|artisan|database/|storage/logs/|storage/framework/|app/|bootstrap/|config/|resources/|routes/|vendor/) - [F,L,NC]
    RewriteRule \.(env|yml|yaml|json|lock|sql|sqlite|log|sh|bak|swp|dist|md)$ - [F,L,NC]

    # 2. Canonical: Enforce HTTPS (excluding local development environments)
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 3. Canonical: Enforce non-www domain
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    # 4. Strip /public/ from URL if explicitly requested in THE_REQUEST
    RewriteCond %{THE_REQUEST} \s/+public(?:/([^\s?]*))? [NC]
    RewriteRule ^ /%1 [R=301,L,NE]

    # 5. Transparently forward all non-public requests into the public/ directory
    # Static files (images, css, js, storage) and application routes are handled inside public/.htaccess
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Disable directory browsing
Options -Indexes -MultiViews
